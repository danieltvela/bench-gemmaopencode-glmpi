{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "bench-gemma": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Gemma-4 (bench)",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "timeout": 900000,
        "chunkTimeout": 120000
      },
      "models": {
        "gemma4-31b": {
          "name": "Gemma-4 31B (local)",
          "limit": {
            "context": 262144,
            "output": 65536
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "reasoning": true
        }
      }
    }
  },
  "model": "bench-gemma/gemma4-31b",
  "agent": {
    "build": {
      "mode": "primary",
      "model": "bench-gemma/gemma4-31b",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "allow",
          "git push*": "deny",
          "git pull*": "deny",
          "git merge*": "deny"
        },
        "task": "allow"
      }
    }
  }
}
